# Copy to .env and fill in. NEVER commit .env.
#
# Sandbox credentials come from your Global Payments developer account:
#   https://developer.globalpay.com  ->  sign up  ->  App Credentials
# Production credentials come from your account manager, not the portal.

GP_APP_ID=
GP_APP_KEY=

# sandbox | production | sandbox-eu | production-eu | mock
# "mock" points the client at the local offline emulator (npm run mock).
GP_ENVIRONMENT=sandbox

# Default transaction context. CHANNEL is CNP (card not present, e-commerce)
# or CP (card present, terminal). Pay by Link is inherently CNP.
GP_CHANNEL=CNP
GP_COUNTRY=GB

# Optional: pin a specific merchant account. If unset, the client reads the
# first TRANSACTION_PROCESSING account out of the access token's scope.
GP_ACCOUNT_NAME=

# Where the mock emulator listens (only used when GP_ENVIRONMENT=mock)
GP_MOCK_PORT=8088
