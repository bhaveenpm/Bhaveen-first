# Copy to .env and fill in. NEVER commit .env.
#
# Sandbox credentials come from your Global Payments developer account:
#   https://developer.globalpay.com  ->  sign up  ->  App Credentials
# Production credentials come from your account manager, not the portal.

GP_APP_ID=
GP_APP_KEY=

# sandbox | production | sandbox-eu | production-eu | mock
# "mock" points the client at the local offline emulator (npm run mock).
#
# IMPORTANT: this must match the REGION you picked when creating the app in the
# developer portal, and that choice is irreversible ("Once selected, you cannot
# change this region"). An Ireland / Europe app authenticates against the EU
# host, so use sandbox-eu. A US app uses sandbox. Credentials from one region
# simply do not work against the other, and the failure looks like bad
# credentials rather than a wrong host -- which is why this trips people up.
GP_ENVIRONMENT=sandbox

# Default transaction context. CHANNEL is CNP (card not present, e-commerce)
# or CP (card present, terminal). Pay by Link is inherently CNP.
GP_CHANNEL=CNP
GP_COUNTRY=GB

# Optional: pin a specific merchant account. If unset, the client reads the
# first TRANSACTION_PROCESSING account out of the access token's scope.
GP_ACCOUNT_NAME=

# Where the mock emulator listens (only used when GP_ENVIRONMENT=mock)
GP_MOCK_PORT=8088


# =====================================================================
# Stripe  (see notes/07-stripe-integration-plan.md)
# =====================================================================
# Test keys: https://dashboard.stripe.com/test/apikeys
#
# Prefer a RESTRICTED key (rk_test_...) over a full secret key (sk_test_...).
# A restricted key scoped to the resources a service actually needs limits the
# blast radius of a leak to those resources. `npm run stripe:doctor` warns if
# you're using a full-access key.
STRIPE_SECRET_KEY=

# The only key that may reach a browser.
STRIPE_PUBLISHABLE_KEY=

# Per-endpoint, and DIFFERENT for test and live. Locally, get it from:
#   stripe listen --forward-to localhost:3000/stripe/webhook
# Without it, webhook signature verification refuses to run -- by design, since
# an unverified webhook is an open endpoint anyone can POST to.
STRIPE_WEBHOOK_SECRET=

# Your platform's cut of each connected-account sale, in basis points.
# 250 = 2.5%. Applied as application_fee_amount on destination charges.
STRIPE_APPLICATION_FEE_BPS=250
